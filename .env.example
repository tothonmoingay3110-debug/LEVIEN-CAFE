NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only: never expose this value with a NEXT_PUBLIC_ prefix.
SUPABASE_SERVICE_ROLE_KEY=
# Temporary V2.1A legacy Owner fallback. Keep until the first Supabase Auth
# Owner account has been created and tested in production.
ADMIN_USERNAME=admin
# Production requires at least 12 characters and a non-default value.
ADMIN_PASSWORD=
# Use a random value containing at least 32 characters.
ADMIN_SESSION_SECRET=
# Public canonical Vercel/custom-domain origin. No trailing slash.
NEXT_PUBLIC_SITE_URL=https://your-domain.example
# Server-only Stripe keys. Configure the webhook endpoint at
# /api/payments/stripe/webhook and subscribe to the documented events.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# 32 random bytes encoded as 64 hex characters or Base64.
GIFT_CARD_ENCRYPTION_KEY=
# Server-only email delivery for paid digital Gift Cards.
RESEND_API_KEY=
GIFT_CARD_FROM_EMAIL=LEVIEN CAFE <giftcards@your-domain.example>
